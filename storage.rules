rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'userex157@gmail.com';
    }

    match /media/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
